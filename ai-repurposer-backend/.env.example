# Copy to .env and fill in. Never commit .env.

# ── Server ────────────────────────────────────────────────
PORT=3001
# Comma-separated. Credentialed CORS forbids a wildcard, so the frontend
# origin must be listed exactly.
CORS_ORIGINS=http://localhost:3000
# Used to build verification and password-reset links.
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────
# Port 5434 matches docker-compose.yml, which deliberately avoids 5432: a
# native PostgreSQL install commonly owns that port and silently wins the
# loopback binding, leaving the container unused.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ai_content_repurposer_db?schema=public"

# ── Redis (queue + usage counters) ────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380

# ── Auth ──────────────────────────────────────────────────
# Must differ from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cookie attributes. Defaults suit local same-site development.
# A cross-domain deployment needs COOKIE_SAMESITE=none, which forces Secure,
# requires HTTPS, and gives up the CSRF protection Lax provides for free.
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production.
COOKIE_SECURE=
COOKIE_DOMAIN=

# ── Google OAuth ──────────────────────────────────────────
# Callback points at the BACKEND port.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ── AI providers ──────────────────────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── SMTP (verification + password reset) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
