generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String   @id @default(uuid())
  email                   String   @unique
  password                String
  name                    String?
  googleId                String?  @unique
  refreshToken            String?
  plan                    Plan     @default(FREE)
  // `jobsUsedThisMonth` and `usagePeriodStart` used to sit here. Nothing ever
  // read or wrote them — Redis is the sole quota store (see usage.service.ts) —
  // so they looked authoritative while always holding their defaults. Removed
  // rather than left as a trap. Quota still resets if Redis is flushed.
  createdAt               DateTime @default(now())
  emailVerified           Boolean  @default(false)
  emailVerificationToken  String?  @unique
  emailVerificationExpires DateTime?
  passwordResetToken      String?  @unique
  passwordResetExpires    DateTime?
  jobs                    Job[]
}

enum Plan {
  FREE
  PRO
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ContentType {
  TWITTER_THREAD
  BLOG_POST
  FACEBOOK_POST
  HIGHLIGHTS
}

model Job {
  id               String             @id @default(uuid())
  videoUrl         String
  status           JobStatus          @default(QUEUED)
  language         String             @default("Arabic")
  // ISO-2 code of the country whose Arabic dialect the content was written in.
  // Null means Modern Standard Arabic, which is what every job predating this
  // column used. See src/common/config/dialects.config.ts.
  country          String?
  // Why a FAILED job failed, phrased for the person who submitted it. Only ever
  // set from the mapped constants in job-error.ts — never a raw exception
  // message, which would leak temp-file paths and the yt-dlp command line.
  error            String?
  createdAt        DateTime           @default(now())
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  updatedAt        DateTime           @updatedAt
  imageUrl         String?
  generatedContent GeneratedContent[]

  // The dashboard's only query is `where userId order by createdAt desc`, so it
  // wants both columns in one index — `userId` alone would still leave a sort.
  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model GeneratedContent {
  id        String      @id @default(uuid())
  jobId     String
  type      ContentType
  body      String      @db.Text
  createdAt DateTime    @default(now())
  job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, type])
  @@index([jobId])
}
