report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

/generated/prisma

# Incremental build cache. A stale copy makes `nest build` silently emit
# nothing, so it must never be committed.
*.tsbuildinfo

# prisma/migrations is deliberately NOT ignored. Migrations are the schema's
# source of truth — ignoring them is what left this project unable to build a
# working database from a clean checkout.